# HuggingFace token with read access to gated model `nvidia/Alpamayo-1.5-10B`.
# Get one at https://huggingface.co/settings/tokens (fine-grained, read scope).
HF_TOKEN=

# Optional: override HF endpoint (e.g. internal mirror on KADaP).
# HF_ENDPOINT=https://huggingface.co

# Optional: GPU index passed to Alpasim wizard (default 0).
GPU_DEVICE=0

# Optional: where Alpasim writes rollouts and logs. Defaults to ./run_dir
# inside the alpasim/ submodule. Dashboard reads from this path.
RUN_DIR=./alpasim/run_dir

# Optional: dashboard bind port (matches KADaP port-forward rule).
DASHBOARD_PORT=7860
