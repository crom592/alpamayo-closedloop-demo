@app.post("/report/build", response_class=HTMLResponse)
async def report_build(request: Request, uuid: str):
    rollout = next((r for r in existing_rollouts() if r.rollout_uuid == uuid), None)
    if rollout is None:
        return HTMLResponse(f"<div class='error'>❌ rollout {uuid} 없음</div>")
    import report

    try:
        pdf_path = report.build_report(rollout)
    except Exception as e:  # noqa: BLE001
        return HTMLResponse(
            f"<div class='error'>생성 실패: {e.__class__.__name__}: {e}</div>"
        )
    return HTMLResponse(
        f"<div class='success'>✅ <a href='/report/file/{pdf_path.name}'>"
        f"{pdf_path.name}</a> 생성됨 ({pdf_path.stat().st_size / 1024:.1f} KB)</div>"
    )


@app.get("/report/file/{name}")
async def report_file(name: str):
    p = Path("/tmp/kadap-poc-reports") / name
    if not p.exists():
        return HTMLResponse("not found", status_code=404)
    return FileResponse(str(p), media_type="application/pdf", filename=name)


# V2X Q&A tab — California-data direct inference (mirrors original ARM POC)
import vlm_qa  # noqa: E402  (heavy imports, deferred)
from fastapi.responses import Response  # noqa: E402

# Cache the last result so the inline PNGs can be re-served without re-running.
LAST_VQA: dict[str, vlm_qa.VqaResult] = {}


@app.get("/tab/vqa", response_class=HTMLResponse)
async def tab_vqa(request: Request):
    samples = vlm_qa.load_samples()
    rows = [
        {
            "idx": s["_idx"],
            "label": f"[{s['_idx']:02d}] {s['_category']} · d={s['distance_m']:.1f}m · {s['nav_text']}",
            "default_v2x": s["nav_text"],
        }
        for s in samples
    ]
    return TEMPLATES.TemplateResponse(
        request,
        "tab_vqa.html",
        {
            "samples": rows,
            "state": vlm_qa.model_status(),
        },
    )


@app.get("/vqa/model_status", response_class=HTMLResponse)
async def vqa_model_status(request: Request):
    return TEMPLATES.TemplateResponse(
        request, "_vqa_model_status.html", {"state": vlm_qa.model_status()}
    )


@app.post("/vqa/load_model", response_class=HTMLResponse)
async def vqa_load_model(request: Request):
    # Fire and forget — caller polls /vqa/model_status.
    def _load() -> None:
        try:
            vlm_qa.ensure_model()
        except Exception:  # noqa: BLE001
            pass

    PARSE_EXECUTOR.submit(_load)
    return TEMPLATES.TemplateResponse(
        request, "_vqa_model_status.html", {"state": vlm_qa.model_status()}
    )


@app.post("/vqa/run", response_class=HTMLResponse)
async def vqa_run(request: Request):
    form = await request.form()
    try:
        idx = int(form.get("scenario_idx", "0"))
    except ValueError:
        idx = 0
    v2x_text = form.get("v2x_text", "")
    do_baseline = form.get("do_baseline") == "on"
    do_counterfactual = form.get("do_counterfactual") == "on"
    loop = asyncio.get_event_loop()
    try:
        result = await loop.run_in_executor(
            PARSE_EXECUTOR,
            lambda: vlm_qa.run_three_conditions(
                idx, v2x_text, do_baseline, do_counterfactual
            ),
        )
    except Exception as e:  # noqa: BLE001
        return HTMLResponse(
            f"<div class='error'>추론 실패: {e.__class__.__name__}: {e}</div>"
        )
    token = uuid.uuid4().hex[:8]
    LAST_VQA[token] = result
    return TEMPLATES.TemplateResponse(
        request, "_vqa_result.html", {"token": token, "result": result}
    )


@app.get("/vqa/img/{token}/{kind}")
async def vqa_img(token: str, kind: str):
    result = LAST_VQA.get(token)
    if result is None:
        return Response(status_code=404)
    if kind == "bev":
        return Response(content=result.bev_png, media_type="image/png")
    if kind == "cam":
        return Response(content=result.camera_png, media_type="image/png")
    return Response(status_code=404)


@app.get("/tab/catalog", response_class=HTMLResponse)
async def tab_catalog(request: Request):
    import scenarios

    catalog = scenarios.load_catalog()[:50]
    rows = []
    for r in catalog:
        rows.append(
            {
                "scene_id": r.scene_id,
                "scene_short": r.scene_id[:36],
                "uuid": r.uuid,
                "is_local": r.is_local(),
            }
        )
    summary = scenarios.summary()
    return TEMPLATES.TemplateResponse(
        request, "tab_catalog.html", {"rows": rows, "summary": summary}
    )


@app.post("/catalog/download", response_class=HTMLResponse)
async def catalog_download(request: Request, scene_id: str):
    import scenarios

    row = scenarios.get(scene_id)
    if row is None:
        return HTMLResponse(f"<div class='error'>❌ {scene_id} 없음</div>")
    if row.is_local():
        return HTMLResponse("<div class='success'>✅ 이미 로컬에 있음</div>")
    try:
        p = await asyncio.get_event_loop().run_in_executor(
            SIM_EXECUTOR, lambda: scenarios.download(row)
        )
    except Exception as e:  # noqa: BLE001
        return HTMLResponse(
            f"<div class='error'>다운로드 실패: {e.__class__.__name__}: {e}</div>"
        )
    return HTMLResponse(
        f"<div class='success'>✅ 받음: {p.name} ({p.stat().st_size / 1e6:.1f} MB)</div>"
    )


@app.get("/healthz")
async def healthz() -> JSONResponse:
    return JSONResponse({"ok": True, "rollouts": len(existing_rollouts())})


if __name__ == "__main__":
    import uvicorn

    port = int(os.environ.get("KADAP_POC_PORT", "7861"))
    host = os.environ.get("KADAP_POC_HOST", "0.0.0.0")
    uvicorn.run(app, host=host, port=port, log_level="info")
