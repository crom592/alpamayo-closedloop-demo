"""KADaP Alpamayo PoC v2 — FastAPI + HTMX frontend for KATECH delivery.

Migration target after Gradio hit the 100+ component scaling wall. v2 keeps
the existing backend modules (runner, ablation, trace, metrics, scenarios,
report) and only replaces the UI layer.

Phase 1 (this commit): scaffolding + Tab ① 시나리오 평가 feature-parity.
"""

from __future__ import annotations

import asyncio
import os
import sys
import uuid
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

from fastapi import FastAPI, Request
from fastapi.responses import FileResponse, HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates

# Reuse the kadap-poc backend modules verbatim — same Python venv.
REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "kadap-poc"))

import ablation  # noqa: E402
from runner import (  # noqa: E402
    ROLLOUTS_DIR,
    RolloutRef,
    existing_rollouts,
    latest_rollout_for_ablation,
    render_camera_mp4,
    run_oneshot,
)

ABLATION_LABEL = {
    "base": "Base (모든 카메라, t0=300ms)",
    "no_left": "좌측 카메라 마스킹",
    "no_tele": "전방 망원 마스킹",
    "front_only": "전방 wide 단독",
    "start_500ms": "시작 0.5s 지연",
    "start_2s": "시작 2.0s 지연",
    "start_5s": "시작 5.0s 지연",
}
SCENARIO_CATALOG = {
    "clipgt-01d503d4-449b-46fc-8d78-9085e70d3554": "도심 일반 주행 (clipgt-01d503d4)",
}

HERE = Path(__file__).resolve().parent
TEMPLATES = Jinja2Templates(directory=str(HERE / "templates"))

app = FastAPI(title="KADaP Alpamayo PoC v2 (KATECH)")
app.mount("/static", StaticFiles(directory=str(HERE / "static")), name="static")
# Serve rollout artifacts (MP4s, JPEGs) under /artifacts/<scene>/<uuid>/...
app.mount(
    "/artifacts",
    StaticFiles(directory=str(ROLLOUTS_DIR)),
    name="artifacts",
)

# Single executor for blocking sim runs (one at a time on A40).
SIM_EXECUTOR = ThreadPoolExecutor(max_workers=1, thread_name_prefix="sim")
# Separate executor for asl parsing (parse_steps, metrics.compute) — they call
# asyncio.run() internally which clashes with FastAPI's running event loop;
# off-loading to threads gives each call its own loop.
PARSE_EXECUTOR = ThreadPoolExecutor(max_workers=4, thread_name_prefix="parse")

# In-memory job registry. Production would be Redis or sqlite.
JOBS: dict[str, dict] = {}


# ---- helpers ---------------------------------------------------------------


def _rollout_to_view(r: RolloutRef) -> dict:
    """Plain-dict view of a rollout for templates."""
    return {
        "uuid": r.rollout_uuid,
        "uuid_short": r.rollout_uuid[:12],
        "scenario_id": r.scenario_id,
        "scenario_short": r.scenario_id[:24],
        "driver": r.driver,
        "ablation": r.ablation,
        "asl_mb": r.asl.stat().st_size / 1024 / 1024,
    }


def _rollout_mp4_url(r: RolloutRef) -> str | None:
    """Return a URL the browser can hit, or None if the MP4 cache is empty."""
    mp4 = render_camera_mp4(r, force=False)  # cache-only — never block
    if mp4 is None:
        return None
    # The artifacts mount serves ROLLOUTS_DIR/<scene>/<uuid>/... directly.
    rel = mp4.relative_to(ROLLOUTS_DIR)
    return f"/artifacts/{rel.as_posix()}"


# ---- routes ----------------------------------------------------------------


@app.get("/", response_class=HTMLResponse)
async def landing(request: Request):
    """Page shell with tab nav. HTMX swaps inner #content per tab click."""
    return TEMPLATES.TemplateResponse(
        request,
        "base.html",
        {"active_tab": "scenarios"},
    )


@app.get("/tab/scenarios", response_class=HTMLResponse)
async def tab_scenarios(request: Request):
    rollouts = [_rollout_to_view(r) for r in existing_rollouts()]
    return TEMPLATES.TemplateResponse(
        request, "tab_scenarios.html", {"rollouts": rollouts}
    )


@app.get("/scenarios/preview", response_class=HTMLResponse)
async def scenarios_preview(request: Request, uuid: str | None = None):
    if not uuid:
        return HTMLResponse("<div class='muted'>_rollout을 선택하세요_</div>")
    rollout = next((r for r in existing_rollouts() if r.rollout_uuid == uuid), None)
    if rollout is None:
        return HTMLResponse(f"<div class='error'>❌ rollout {uuid} 없음</div>")
    # Force MP4 render — explicit user action, blocking acceptable
    mp4_url = None
    try:
        mp4 = render_camera_mp4(rollout, force=True)
        if mp4:
            rel = mp4.relative_to(ROLLOUTS_DIR)
            mp4_url = f"/artifacts/{rel.as_posix()}"
    except Exception as e:  # noqa: BLE001
        return HTMLResponse(
            f"<div class='error'>MP4 변환 실패: {e.__class__.__name__}: {e}</div>"
        )
    return TEMPLATES.TemplateResponse(
        request,
        "_rollout_preview.html",
        {"rollout": _rollout_to_view(rollout), "mp4_url": mp4_url},
    )


def _sim_runner(job_id: str, driver: str) -> None:
    """Runs in the SIM_EXECUTOR thread; updates JOBS[job_id] dict."""

    def on_progress(pct: float, msg: str) -> None:
        JOBS[job_id]["pct"] = pct
        JOBS[job_id]["msg"] = msg

    try:
        rollout = run_oneshot(driver=driver, on_progress=on_progress)
        JOBS[job_id].update(
            {"state": "done", "pct": 1.0, "msg": "완료", "rollout_uuid": rollout.rollout_uuid}
        )
    except Exception as e:  # noqa: BLE001
        JOBS[job_id].update(
            {"state": "error", "msg": f"{e.__class__.__name__}: {e}", "pct": 0.0}
        )


@app.post("/scenarios/run", response_class=HTMLResponse)
async def scenarios_run(request: Request, driver: str = "alpamayo1_5"):
    job_id = uuid.uuid4().hex[:8]
    JOBS[job_id] = {"state": "running", "pct": 0.0, "msg": "큐 진입", "driver": driver}
    SIM_EXECUTOR.submit(_sim_runner, job_id, driver)
    return TEMPLATES.TemplateResponse(
        request,
        "_run_progress.html",
        {"job_id": job_id, "job": JOBS[job_id]},
    )


@app.get("/scenarios/run/{job_id}", response_class=HTMLResponse)
async def scenarios_run_poll(request: Request, job_id: str):
    job = JOBS.get(job_id)
    if job is None:
        return HTMLResponse("<div class='error'>unknown job</div>")
    return TEMPLATES.TemplateResponse(
        request, "_run_progress.html", {"job_id": job_id, "job": job}
    )


@app.get("/tab/ablation", response_class=HTMLResponse)
async def tab_ablation(request: Request):
    return TEMPLATES.TemplateResponse(
        request,
        "tab_ablation.html",
        {
            "scenarios": [{"id": k, "label": v} for k, v in SCENARIO_CATALOG.items()],
            "presets": [
                {"name": n, "label": ABLATION_LABEL.get(n, n)}
                for n in ablation.PRESETS
            ],
        },
    )


def _slot_view(rollout: RolloutRef | None, label: str) -> dict:
    if rollout is None:
        return {"label": label, "empty": True}
    mp4_url = _rollout_mp4_url(rollout)
    return {
        "label": label,
        "empty": False,
        "uuid_short": rollout.rollout_uuid[:12],
        "asl_mb": rollout.asl.stat().st_size / 1024 / 1024,
        "mp4_url": mp4_url,
    }


@app.get("/ablation/existing", response_class=HTMLResponse)
async def ablation_existing(request: Request, scenario: str, names: str = ""):
    """Look up most recent rollout for each (scenario, ablation) — no run."""
    name_list = [n for n in names.split(",") if n]
    slots = []
    for n in name_list[:4]:
        r = latest_rollout_for_ablation(scenario, n)
        slots.append(_slot_view(r, ABLATION_LABEL.get(n, n)))
    hits = sum(1 for s in slots if not s["empty"])
    status = f"📁 {hits}/{len(name_list[:4])} 매치"
    return TEMPLATES.TemplateResponse(
        request,
        "_ablation_grid.html",
        {"status": status, "slots": slots},
    )


@app.post("/ablation/run", response_class=HTMLResponse)
async def ablation_run(request: Request):
    form = await request.form()
    scenario = form.get("scenario", "")
    names = [k for k in form.getlist("ablation")]
    if not names:
        return HTMLResponse("<div class='error'>ablation 1개 이상 선택</div>")
    job_id = uuid.uuid4().hex[:8]
    JOBS[job_id] = {
        "kind": "ablation",
        "state": "running",
        "pct": 0.0,
        "msg": "큐 진입",
        "scenario": scenario,
        "names": names[:4],
        "slots": [],
    }
    SIM_EXECUTOR.submit(_ablation_runner, job_id, scenario, names[:4])
    return TEMPLATES.TemplateResponse(
        request,
        "_ablation_progress.html",
        {"job_id": job_id, "job": JOBS[job_id]},
    )


def _ablation_runner(job_id: str, scenario: str, names: list[str]) -> None:
    n = len(names)
    slots: list[dict] = []
    try:
        for i, name in enumerate(names):
            base = i / n
            spec = ablation.PRESETS[name]
            label = ABLATION_LABEL.get(name, name)

            def on_progress(pct: float, msg: str, _b=base, _l=label, _i=i) -> None:
                JOBS[job_id]["pct"] = _b + pct / n
                JOBS[job_id]["msg"] = f"[{_i + 1}/{n}] {_l}: {msg}"

            try:
                r = run_oneshot(
                    driver="alpamayo1_5",
                    scene_ids=[scenario] if scenario else None,
                    ablation=spec,
                    on_progress=on_progress,
                )
                slots.append(_slot_view(r, label))
            except Exception as e:  # noqa: BLE001
                slots.append({"label": label, "empty": True, "error": str(e)})
            JOBS[job_id]["slots"] = slots
        JOBS[job_id].update({"state": "done", "pct": 1.0, "msg": f"완료 ({n}개)"})
    except Exception as e:  # noqa: BLE001
        JOBS[job_id].update({"state": "error", "msg": f"{e.__class__.__name__}: {e}"})


@app.get("/ablation/run/{job_id}", response_class=HTMLResponse)
async def ablation_run_poll(request: Request, job_id: str):
    job = JOBS.get(job_id)
    if job is None:
        return HTMLResponse("<div class='error'>unknown job</div>")
    return TEMPLATES.TemplateResponse(
        request, "_ablation_progress.html", {"job_id": job_id, "job": job}
    )


# Tab ⑥ — closed-loop trace
@app.get("/tab/trace", response_class=HTMLResponse)
async def tab_trace(request: Request):
    rollouts = [_rollout_to_view(r) for r in existing_rollouts()]
    return TEMPLATES.TemplateResponse(
        request, "tab_trace.html", {"rollouts": rollouts}
    )


@app.get("/trace/load", response_class=HTMLResponse)
async def trace_load(request: Request, uuid: str | None = None):
    if not uuid:
        return HTMLResponse("<div class='muted'>_rollout을 선택하세요_</div>")
    rollout = next((r for r in existing_rollouts() if r.rollout_uuid == uuid), None)
    if rollout is None:
        return HTMLResponse(f"<div class='error'>❌ rollout {uuid} 없음</div>")
    import trace as trace_mod  # local import: heavy

    loop = asyncio.get_event_loop()
    steps = await loop.run_in_executor(
        PARSE_EXECUTOR, lambda: trace_mod.parse_steps(rollout)
    )
    cached = (rollout.dir / trace_mod.FRAMES_DIRNAME).exists()
    return TEMPLATES.TemplateResponse(
        request,
        "_trace_loaded.html",
        {
            "uuid": uuid,
            "n_steps": len(steps),
            "max_step": max(0, len(steps) - 1),
            "frames_cached": cached,
        },
    )


@app.get("/trace/step", response_class=HTMLResponse)
async def trace_step(request: Request, uuid: str, step: int = 0):
    rollout = next((r for r in existing_rollouts() if r.rollout_uuid == uuid), None)
    if rollout is None:
        return HTMLResponse(f"<div class='error'>❌ rollout {uuid} 없음</div>")
    import trace as trace_mod

    loop = asyncio.get_event_loop()
    steps = await loop.run_in_executor(
        PARSE_EXECUTOR, lambda: trace_mod.parse_steps(rollout)
    )
    if not steps:
        return HTMLResponse("<div class='muted'>_step 정보 없음_</div>")
    step_idx = max(0, min(int(step), len(steps) - 1))
    s = steps[step_idx]
    # camera frame paths -> URLs
    cam_dict = trace_mod.step_cameras(rollout, step_idx)
    cams = []
    for cam_id in [
        "camera_front_wide_120fov",
        "camera_front_tele_30fov",
        "camera_cross_left_120fov",
        "camera_cross_right_120fov",
    ]:
        p = cam_dict.get(cam_id)
        url = None
        if p is not None:
            try:
                url = f"/artifacts/{p.relative_to(ROLLOUTS_DIR).as_posix()}"
            except ValueError:
                url = None
        cams.append({"id": cam_id, "url": url})
    # build Plotly trajectory data for the past window of steps
    window = max(0, step_idx - 20)
    past = steps[window : step_idx + 1]
    ego_xs = [p.ego_xy[0] for p in past]
    ego_ys = [p.ego_xy[1] for p in past]
    pred_xy = s.last_predicted_xy
    return TEMPLATES.TemplateResponse(
        request,
        "_trace_step.html",
        {
            "step": s,
            "step_idx": step_idx,
            "cams": cams,
            "ego_xs": ego_xs,
            "ego_ys": ego_ys,
            "pred_xy": pred_xy,
        },
    )


@app.post("/trace/extract", response_class=HTMLResponse)
async def trace_extract(uuid: str):
    rollout = next((r for r in existing_rollouts() if r.rollout_uuid == uuid), None)
    if rollout is None:
        return HTMLResponse(f"<div class='error'>❌ rollout {uuid} 없음</div>")
    import trace as trace_mod

    loop = asyncio.get_event_loop()
    await loop.run_in_executor(
        SIM_EXECUTOR, lambda: trace_mod.ensure_frames_extracted(rollout, force=True)
    )
    return HTMLResponse(
        "<div class='success'>✅ frames 캐시 갱신됨 — rollout 다시 선택하세요</div>"
    )


# Phase 4 — metrics / system / report / catalog
@app.get("/tab/metrics", response_class=HTMLResponse)
async def tab_metrics(request: Request):
    rollouts = [_rollout_to_view(r) for r in existing_rollouts()]
    return TEMPLATES.TemplateResponse(
        request, "tab_metrics.html", {"rollouts": rollouts}
    )


@app.get("/metrics/single", response_class=HTMLResponse)
async def metrics_single(request: Request, uuid: str | None = None):
    if not uuid:
        return HTMLResponse("<div class='muted'>_rollout 선택_</div>")
    rollout = next((r for r in existing_rollouts() if r.rollout_uuid == uuid), None)
    if rollout is None:
        return HTMLResponse(f"<div class='error'>❌ rollout {uuid} 없음</div>")
    import metrics

    loop = asyncio.get_event_loop()
    m = await loop.run_in_executor(PARSE_EXECUTOR, lambda: metrics.compute(rollout.asl))
    if m.is_empty:
        return HTMLResponse("<div class='muted'>⚠️ controller_return 없음</div>")
    return TEMPLATES.TemplateResponse(
        request,
        "_metrics_single.html",
        {
            "rollout": _rollout_to_view(rollout),
            "m": m,
            "t": list(map(float, m.series.t)),
            "speed": list(map(float, m.series.speed)),
            "lat": list(map(float, m.series.lateral_accel)),
            "jerk": list(map(float, m.series.jerk)),
        },
    )


@app.get("/metrics/overlay", response_class=HTMLResponse)
async def metrics_overlay(request: Request, uuids: str = ""):
    uuid_list = [u for u in uuids.split(",") if u]
    if len(uuid_list) < 2:
        return HTMLResponse("<div class='muted'>2개 이상 선택</div>")
    import metrics

    loop = asyncio.get_event_loop()
    series: list[dict] = []
    for u in uuid_list[:4]:
        r = next((x for x in existing_rollouts() if x.rollout_uuid == u), None)
        if r is None:
            continue
        try:
            m = await loop.run_in_executor(
                PARSE_EXECUTOR, lambda r=r: metrics.compute(r.asl)
            )
        except Exception:  # noqa: BLE001
            continue
        if m.is_empty:
            continue
        series.append(
            {
                "uuid_short": r.rollout_uuid[:8],
                "ablation": r.ablation,
                "t": list(map(float, m.series.t)),
                "speed": list(map(float, m.series.speed)),
                "lat": list(map(float, m.series.lateral_accel)),
                "jerk": list(map(float, m.series.jerk)),
                "n_steps": m.n_steps,
                "avg_speed": m.avg_speed,
                "max_lat": m.max_lateral_accel,
                "max_jerk": m.max_jerk,
            }
        )
    return TEMPLATES.TemplateResponse(
        request,
        "_metrics_overlay.html",
        {"series": series},
    )


@app.get("/tab/system", response_class=HTMLResponse)
async def tab_system(request: Request):
    return TEMPLATES.TemplateResponse(request, "tab_system.html", {})


@app.get("/system/refresh", response_class=HTMLResponse)
async def system_refresh(request: Request):
    import subprocess

    def sh(cmd: list[str], timeout: int = 8) -> str:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
            return (r.stdout + r.stderr).strip()
        except Exception as e:  # noqa: BLE001
            return f"<<error: {e}>>"

    services = ["controller-0", "driver-0", "physics-0", "sensorsim-0", "runtime-0"]
    docker_ps = sh(["docker", "ps", "-a", "--format", "{{.Names}}\t{{.Status}}"])
    svc_status = {s: "—" for s in services}
    for line in docker_ps.splitlines():
        if "\t" not in line:
            continue
        name, status = line.split("\t", 1)
        for s in services:
            if s in name:
                svc_status[s] = status
                break
    gpu = sh(
        [
            "nvidia-smi",
            "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
            "--format=csv,noheader,nounits",
        ],
        timeout=5,
    )
    return TEMPLATES.TemplateResponse(
        request,
        "_system_refresh.html",
        {"services": svc_status, "gpu": gpu},
    )


@app.get("/tab/report", response_class=HTMLResponse)
async def tab_report(request: Request):
    rollouts = [_rollout_to_view(r) for r in existing_rollouts()]
    return TEMPLATES.TemplateResponse(
